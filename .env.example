# Enquiry form endpoint (Formspree or Web3Forms). Leave empty to disable
# sending; the form will then point visitors to WhatsApp instead.
#   Formspree:  https://formspree.io/f/your-form-id
#   Web3Forms:  https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ENDPOINT=

# Web3Forms only: your public access key (sent as "access_key"). Create it at
# web3forms.com with the email that should receive enquiries
# (vphenterprises@gmail.com); the key is emailed to that address.
# Not needed for Formspree.
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Public site URL, used for canonical and Open Graph links,
# e.g. https://www.vphenterprises.in
# (falls back to the Vercel production URL when deployed on Vercel).
NEXT_PUBLIC_SITE_URL=
